# Copie para .env e ajuste. Todos os valores têm default: a app sobe sem este arquivo.

# Chave de assinatura de sessão/token. Obrigatória em produção.
SECRET_KEY=troque-esta-chave

# Servidor
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Origens permitidas no CORS ("*" mantém o comportamento original; use lista separada por vírgula)
CORS_ORIGINS=*

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# URL SQLAlchemy do banco (default: SQLite em instance/tasks.db)
DATABASE_URL=sqlite:///tasks.db

# Token exigido no header X-Admin-Token para DELETE /users/<id> e para definir role/active.
# Sem valor, essas operações respondem 403.
ADMIN_TOKEN=

# Validade do token retornado por POST /login (segundos)
TOKEN_MAX_AGE=86400

# SMTP para notificações de atribuição de task (opcional; sem SMTP_HOST apenas loga)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
