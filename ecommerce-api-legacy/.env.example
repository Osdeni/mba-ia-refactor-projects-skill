# Copie para .env (ou exporte no ambiente). Todos os valores têm default: a app sobe sem este arquivo.

# Ambiente de execução (development | production)
NODE_ENV=development

# true habilita logs detalhados de erro (stack trace no log, nunca na resposta)
DEBUG=false

# Interface e porta do servidor HTTP
HOST=0.0.0.0
PORT=3000

# Arquivo do SQLite (":memory:" = banco em memória recriado a cada boot, com seeds)
DB_FILE=:memory:

# Token exigido no header X-Admin-Token em GET /api/admin/* e DELETE /api/users/:id.
# Sem valor, essas rotas respondem 403.
ADMIN_TOKEN=

# Chave do gateway de pagamento (nunca commitar a chave real)
PAYMENT_GATEWAY_KEY=pk_test_dev_only_change_me

# Nível de log: error | warn | info | debug
LOG_LEVEL=info
