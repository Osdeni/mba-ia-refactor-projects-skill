# Copie para .env (ou exporte no ambiente). Todos os valores têm default: a app sobe sem este arquivo.

# Ambiente de execução (development | production)
NODE_ENV=development

# Detalhes de erro (stack trace no log, mensagem original no corpo 500). Nunca "true" em produção.
DEBUG=false

# Interface e porta do servidor HTTP
HOST=0.0.0.0
PORT=3000

# Arquivo do SQLite. ":memory:" recria o banco e os seeds a cada boot (comportamento original).
DB_FILE=:memory:

# Token exigido no header X-Admin-Token para GET /api/admin/* e DELETE /api/users/:id.
# Sem valor, essas rotas respondem 403.
ADMIN_TOKEN=

# Chave do gateway de pagamento (nunca a chave live em desenvolvimento)
PAYMENT_GATEWAY_KEY=pk_test_dev_only_change_me

# Remetente de e-mails (reservado; não utilizado pelas rotas atuais)
SMTP_USER=

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# Tamanho máximo do corpo JSON
JSON_BODY_LIMIT=100kb
