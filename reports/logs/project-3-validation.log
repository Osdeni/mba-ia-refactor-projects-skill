GET    /tasks/search?q=JWT&status=pending       200  array[1]
GET    /users                                   200  array[3]
GET    /users/1                                 200  ['active', 'created_at', 'email', 'id', 'name', 'password', 'role', 'tasks']
GET    /users/1/tasks                           200  array[4]
GET    /categories                              200  array[4]
GET    /reports/summary                         200  ['generated_at', 'overdue', 'overview', 'recent_activity', 'tasks_by_priority', 'tasks_by_status', 'user_productivity']
GET    /reports/user/1                          200  ['statistics', 'user']
POST   /login                                   200  ['message', 'token', 'user']
POST   /tasks                                   201  ['category_id', 'created_at', 'description', 'due_date', 'id', 'priority', 'status', 'tags', 'title', 'updated_at', 'user_id']
PUT    /tasks/11                                200  ['category_id', 'created_at', 'description', 'due_date', 'id', 'priority', 'status', 'tags', 'title', 'updated_at', 'user_id']
DELETE /tasks/11                                200  ['message']
POST   /users                                   201  ['active', 'created_at', 'email', 'id', 'name', 'password', 'role']
PUT    /users/4                                 200  ['active', 'created_at', 'email', 'id', 'name', 'password', 'role']
POST   /categories                              201  ['color', 'created_at', 'description', 'id', 'name']
PUT    /categories/5                            200  ['color', 'created_at', 'description', 'id', 'name']
DELETE /categories/5                            200  ['message']
DELETE /users/4                                 200  ['message']
-- probes (devem ser 4xx, nunca 500) --
POST   /tasks                                   500  text:<!doctype html> <html lang=en> <title>500 Internal Server Er
GET    /tasks/search?priority=abc               500  text:<!doctype html> <html lang=en> <title>500 Internal Server Er
