# Copie para .env (ou exporte no ambiente). Todos os valores têm default — a app sobe sem este arquivo.

# Segredo da aplicação (obrigatório em produção)
SECRET_KEY=troque-esta-chave

# Servidor de desenvolvimento
DEBUG=false
HOST=127.0.0.1
PORT=5000

# Banco SQLite (arquivo)
DB_PATH=loja.db

# Token das rotas /admin/* (header X-Admin-Token). Vazio → rotas administrativas desabilitadas (403)
ADMIN_TOKEN=

# Origens CORS permitidas, separadas por vírgula (* = todas)
CORS_ORIGINS=*

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Nome do ambiente exibido em /health
APP_ENV=development
